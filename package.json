{
  "type": "module",
  "dependencies": {
    "js2flowchart": "^1.3.5",
    "mathjs": "^15.1.0",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "parcel index.html comtrade-combiner/index.html --port 5000",
    "start": "parcel index.html comtrade-combiner/index.html --port 5000",
    "build": "parcel build index.html comtrade-combiner/index.html --public-url ./ --no-source-maps --no-scope-hoist",
    "build:main": "parcel build index.html --public-url ./ --no-scope-hoist",
    "build:combiner": "parcel build comtrade-combiner/index.html --public-url ./ --no-scope-hoist",
    "preview": "npx serve dist -p 5000",
    "docs": "jsdoc -c jsdoc.json",
    "mermaid": "node generateMermaid.js",
    "mmd2svg": "mmdc -i docs/classDiagram.mmd -o docs/classDiagram.svg",
    "all-docs": "npm run docs && npm run mermaid && npm run mmd2svg"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@parcel/optimizer-terser": "^2.16.3",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "better-docs": "^2.7.3",
    "esprima": "^4.0.1",
    "estraverse": "^5.3.0",
    "jsdoc": "^4.0.5",
    "jsdoc-mermaid": "^1.0.0",
    "mermaid": "^11.12.1",
    "parcel": "^2.16.3"
  }
}
